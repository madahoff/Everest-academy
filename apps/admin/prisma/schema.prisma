// Prisma Schema for Everest Admin
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Plan {
  FREE
  PREMIUM
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  DRAFT
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// Moyen de règlement d'une commande ou d'une recharge.
// WALLET       : débit du solde du portefeuille Wallet API (aucun passage par Vanilla Pay)
// MOBILE_MONEY : paiement Vanilla Pay Mobile Money (MVola, Orange Money, Airtel Money)
// CARD         : paiement Vanilla Pay international (carte bancaire / PayPal)
enum PaymentMethod {
  WALLET
  MOBILE_MONEY
  CARD
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum TopupStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

/// Cycle de vie d'une Masterclass mensuelle.
/// DRAFT     : en préparation, invisible du public.
/// PUBLISHED : proposée à l'inscription.
/// ARCHIVED  : session passée. Conservée telle quelle — c'est l'historique.
enum MasterclassStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// État d'une inscription. Le paiement, lui, se lit sur la commande rattachée :
/// ces deux statuts ne se confondent pas — une inscription peut être confirmée
/// sans commande (session offerte), et une commande payée sans participation.
enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

// Models
model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  emailVerified     DateTime? // Required for OAuth
  password          String? // Hash password (optional for OAuth users)
  passwordChangedAt DateTime? // Used to invalidate JWT sessions issued before a password reset
  image             String?
  role              Role       @default(STUDENT)
  plan              Plan       @default(FREE)
  status            UserStatus @default(ACTIVE)
  // Date d'acquisition du Pack Premium. Ne fait pas autorité sur l'accès — c'est
  // `plan` qui le porte — mais permet d'afficher l'ancienneté de l'abonné.
  premiumSince      DateTime?
  walletBalance     Decimal    @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  accounts       Account[] // OAuth accounts
  sessions       Session[] // User sessions
  favorites      Favorite[]
  purchases      Purchase[]
  cart           CartItem[]
  accessCodes    AccessCode[]
  sectionRatings SectionRating[]
  orders         Order[]
  topups         WalletTopup[]

  masterclassRegistrations MasterclassRegistration[]

  // Identifiant du portefeuille chez le Wallet API (UUID). Le portefeuille est toujours
  // adressable par `ext:<user.id>` ; ce champ n'est conservé que pour le support.
  walletId String?

  @@map("users")
}

// OAuth Account model for NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model for NextAuth.js
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Verification Token for email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("favorites")
}

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String       @db.Text
  heroImage    String // Grande image CTA pour page de détail
  cardImage    String // Petite image pour cards/listes
  welcomeVideo String // URL vidéo de présentation
  price        Decimal      @db.Decimal(10, 2)
  /// Tarif international, en EUROS ENTIERS (voir `PremiumPlan.priceEur`).
  /// NULL = ce cours n'est pas encore proposé hors de Madagascar : le catalogue
  /// l'affiche alors sans prix et son achat est refusé, plutôt que de convertir
  /// l'ariary à un taux deviné.
  priceEur     Decimal?     @db.Decimal(10, 2)
  duration     String       @default("Variable") // Durée du cours (ex: "2h 30min", "5 semaines")
  level        CourseLevel  @default(INTERMEDIATE) // Niveau du cours
  status       CourseStatus @default(DRAFT)
  salesCount   Int          @default(0)
  favorites    Favorite[]
  sections     Section[]
  purchases    Purchase[]
  cartItems    CartItem[]
  accessCodes  AccessCode[]
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("courses")
}

model Section {
  id          String          @id @default(cuid())
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String          @db.Text
  heroImage   String // Grande image CTA section
  cardImage   String // Image moyenne pour cards
  video       String // Vidéo pédagogique
  summary     String          @db.Text // Résumé pour révision
  duration    String? // Durée estimée (ex: "15 min")
  order       Int             @default(0)
  questions   Question[]
  ratings     SectionRating[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("sections")
}

model SectionRating {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5 stars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, userId]) // One rating per user per section
  @@map("section_ratings")
}

model Question {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  order     Int      @default(0)
  answers   Answer[]
  createdAt DateTime @default(now())

  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@map("answers")
}

model Product {
  id        String        @id @default(cuid())
  name      String
  category  String
  price     Decimal       @db.Decimal(10, 2)
  /// Tarif international, en EUROS ENTIERS. NULL = non vendu hors de Madagascar.
  priceEur  Decimal?      @db.Decimal(10, 2)
  stock     Int           @default(0)
  status    ProductStatus @default(IN_STOCK)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  purchases  Purchase[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

/// Offre « Pack Premium » — un achat unique qui ouvre tout le catalogue.
///
/// Ligne UNIQUE, d'identifiant fixe `default` : le tarif est un réglage du produit,
/// pas un catalogue. Il est piloté depuis la console d'administration, jamais depuis
/// le navigateur d'un acheteur — le montant d'une commande est toujours relu ici.
model PremiumPlan {
  id                   String   @id @default("default")
  price                Decimal  @db.Decimal(10, 2)
  /// Tarif international, en EUROS ENTIERS.
  ///
  /// Vanilla Pay reçoit le montant tel quel avec `devise: EUR`, et le Wallet API
  /// applique son taux EUR→MGA sur ce même nombre : un montant en centimes y
  /// serait donc lu comme des euros. D'où la contrainte — pas de centimes, comme
  /// l'ariary n'a pas de subdivision.
  ///
  /// NULL = le pack n'est pas proposé hors de Madagascar.
  priceEur             Decimal? @db.Decimal(10, 2)
  /// Nombre de modules ANNONCÉS sur la durée de l'offre — l'année académique.
  ///
  /// À distinguer du nombre de cours publiés, que le catalogue sait compter tout
  /// seul : le pack se vend sur un programme annoncé, dont une partie seulement est
  /// parue au moment de l'achat. NULL = on annonce simplement ce qui est publié.
  announcedCourseCount Int?
  /// Offre retirée de la vente : le catalogue cesse de la proposer, sans que les
  /// accès déjà accordés ne soient repris.
  active               Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("premium_plan")
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@map("purchases")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // Prevent duplicate course in cart
  @@map("cart_items")
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique // Format: "EVEREST-XXXX-XXXX"
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  used      Boolean   @default(false)
  usedById  String?
  usedBy    User?     @relation(fields: [usedById], references: [id])
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime? // Optional: expiration date

  @@map("access_codes")
}

enum VerificationPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

model VerificationLink {
  id         String              @id @default(cuid())
  tokenHash  String              @unique
  email      String
  purpose    VerificationPurpose
  payload    String?             @db.Text // JSON: { name, passwordHash } pour SIGNUP
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  requestIp  String?

  @@index([email, purpose, createdAt])
  @@map("verification_links")
}

model AuthAuditLog {
  id        String              @id @default(cuid())
  email     String
  purpose   VerificationPurpose
  action    String // "REQUEST" | "CONSUME"
  success   Boolean
  reason    String? // ok, rate_limited, cooldown, invalid_credentials, email_taken, expired, already_used, not_found
  ip        String?
  userAgent String?             @db.Text
  createdAt DateTime            @default(now())

  @@index([email, createdAt])
  @@map("auth_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Paiements — adossés au Wallet API MADA.H (https://wallet-api.madahoff.com)
//
// Le Wallet API est la source de vérité du SOLDE et des ENCAISSEMENTS ; ces deux
// modèles ne tiennent que ce que lui ignore : à quelle commande Everest se rattache
// un paiement, et quel accès accorder quand il réussit.
//
// Le Wallet API n'émet aucun webhook sortant : l'issue d'un paiement direct
// s'apprend en sondant GET /v1/payments/:reference. `Order.paymentReference` est
// la poignée qui permet ce rattrapage.
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("MGA")

  method PaymentMethod
  status OrderStatus   @default(PENDING)

  // Référence du paiement chez le Wallet API (méthodes MOBILE_MONEY / CARD).
  // Nulle pour un règlement au solde, qui n'ouvre aucun paiement Vanilla Pay.
  paymentReference String? @unique
  paymentUrl       String? @db.Text
  // Ligne de grand livre du débit, pour un règlement au solde (méthode WALLET).
  ledgerEntryId    String?

  failureReason String?   @db.Text
  paidAt        DateTime?
  // Horodatage de l'octroi effectif des accès. Sert de verrou : une commande dont
  // grantedAt est déjà renseigné ne peut plus créer de Purchase en double.
  grantedAt     DateTime?

  items OrderItem[]

  /// Inscription à une Masterclass réglée par cette commande, s'il y en a une.
  masterclassRegistration MasterclassRegistration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Ligne « Masterclass » : une place à la session du mois, ni cours ni produit.
  masterclassId String?
  masterclass   Masterclass? @relation(fields: [masterclassId], references: [id])

  // Ligne « Pack Premium » : ni cours ni produit, elle ouvre tout le catalogue.
  // Un booléen explicite plutôt que deux identifiants nuls, pour que l'octroi des
  // accès n'ait jamais à deviner ce qu'il accorde.
  isPremiumPack Boolean @default(false)

  // Titre figé au moment de l'achat : le catalogue peut changer, pas une facture.
  title  String
  amount Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

model WalletTopup {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Référence du paiement chez le Wallet API (PAYxxxx).
  reference String @unique

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("MGA")
  method   PaymentMethod // MOBILE_MONEY ou CARD — jamais WALLET
  status   TopupStatus   @default(INITIATED)

  // Le Wallet API distingue « encaissé » (status SUCCESS) de « portefeuille crédité »
  // (settled). Une recharge SUCCESS non settled attend une régularisation manuelle.
  settled         Boolean @default(false)
  settlementError String? @db.Text
  paymentUrl      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("wallet_topups")
}

// ─────────────────────────────────────────────────────────────────────────────
// Masterclass mensuelle — une session par mois, et son historique.
//
// La « prochaine Masterclass » n'est JAMAIS un drapeau posé sur une ligne : elle se
// déduit du calendrier (première session publiée encore à venir). Il n'y a donc rien
// à remettre à zéro le 1er du mois — le basculement est mécanique, et aucune tâche
// planifiée manquée ne peut laisser le site sur la session du mois précédent.
// `Masterclass.monthKey` (« 2026-09 », unique) matérialise ce rattachement mensuel
// et interdit deux sessions concurrentes sur un même mois.
//
// L'inscription réutilise le circuit de paiement des cours : une `Order` porteuse
// d'un `OrderItem.masterclassId`. La table ci-dessous ne tient que ce que la commande
// ignore — la présence à la séance.
// ─────────────────────────────────────────────────────────────────────────────

model Masterclass {
  id String @id @default(cuid())

  /// Mois de rattachement, au format « YYYY-MM », dans le fuseau de Madagascar.
  /// Unique : une seule Masterclass par mois, c'est la règle du produit.
  monthKey String @unique

  title       String
  description String @db.Text
  /// Nom du formateur, tel qu'annoncé. Volontairement un texte libre et non une
  /// relation vers `User` : l'intervenant d'une session n'a pas toujours de compte.
  instructor  String

  /// Date et heure de la séance. Fait autorité sur « à venir » ou « passée ».
  scheduledAt DateTime
  /// Durée annoncée (« 2h », « une demi-journée »). Libre, comme celle des cours.
  duration    String?
  /// Lieu ou lien de connexion, communiqué dans l'e-mail de confirmation.
  location    String?
  coverImage  String?

  /// Vidéo de présentation, FACULTATIVE : elle explique ce qui va se passer pendant
  /// la séance. Fichier envoyé depuis la console ou lien (YouTube) — `VideoPlayer`
  /// reconnaît les deux. NULL = la vitrine n'affiche simplement aucun lecteur.
  presentationVideo String?

  price    Decimal  @db.Decimal(10, 2)
  /// Tarif international, en EUROS ENTIERS (voir `Course.priceEur`).
  /// NULL = session non proposée hors de Madagascar.
  priceEur Decimal? @db.Decimal(10, 2)

  /// Nombre de places. NULL = pas de limite annoncée.
  capacity Int?

  status MasterclassStatus @default(DRAFT)

  registrations MasterclassRegistration[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@map("masterclasses")
}

model MasterclassRegistration {
  id String @id @default(cuid())

  masterclassId String
  masterclass   Masterclass @relation(fields: [masterclassId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Commande qui règle la place. NULL pour une session offerte, ou tant qu'aucun
  /// paiement n'a été ouvert. Le STATUT DU PAIEMENT se lit là, jamais ici.
  ///
  /// `SetNull` à la suppression : effacer une commande ne doit jamais emporter
  /// l'inscription — c'est l'historique de participation, pas une écriture comptable.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(PENDING)

  /// Montant et devise réellement facturés, figés à l'inscription : le tarif de la
  /// session peut changer ensuite, pas ce qui a été payé.
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("MGA")

  registeredAt DateTime  @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?

  /// Envoi de l'e-mail de confirmation. Horodatage renseigné = envoyé une fois, et
  /// une seule : un second sondage de la commande ne doit pas réexpédier le message.
  /// L'erreur est conservée pour permettre un renvoi depuis la console.
  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Une inscription par personne et par session : la garde qui interdit la double
  /// inscription, y compris en cas de double clic ou de rejeu réseau.
  @@unique([masterclassId, userId])
  @@index([masterclassId, status])
  @@map("masterclass_registrations")
}
