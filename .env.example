# Database
DATABASE_URL="mysql://user:password@localhost:3306/everest_admin"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Auth (Optional)
GOOGLE_CLIENT_ID="xxx"
GOOGLE_CLIENT_SECRET="xxx"

# Resend (Required for transactional + bulk emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM='"Everest Academy" <noreply@yourdomain.com>'

# Magic Link Configuration (optional, defaults shown)
MAGIC_LINK_TTL_MINUTES="15"
MAGIC_LINK_RATE_LIMIT_MAX="3"
MAGIC_LINK_RATE_LIMIT_WINDOW_MINUTES="15"
MAGIC_LINK_RESEND_COOLDOWN_SECONDS="60"

# ─────────────────────────────────────────────────────────────
# Wallet API MADA.H — portefeuille et paiements (partagé avec Viktoo)
# ─────────────────────────────────────────────────────────────
# URL du service. Il est exposé sous le domaine de viktoo-api, par préfixe de chemin :
# le compte marchand Vanilla Pay est partagé et son back-office n'accepte qu'une seule
# URL de base.
WALLET_API_URL="https://viktoo-api.madahoff.com/wallet-api"
# Clé d'API de l'application COMMUNE (slug `madah`), partagée avec Viktoo — c'est elle
# qui rend le solde identique sur les deux produits. L'étanchéité du Wallet API étant
# structurelle, une clé propre à Everest donnerait une caisse séparée.
# SECRET : elle identifie toute l'application et permet de débiter n'importe quel
# portefeuille. Jamais dans le navigateur, jamais commitée.
WALLET_API_KEY="wk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# URL publique du site, utilisée pour construire les URL de retour de paiement.
# À défaut, NEXTAUTH_URL est utilisée. Pas de préfixe NEXT_PUBLIC_ : lue côté serveur
# uniquement, un nom public serait figé à la compilation de l'image.
APP_PUBLIC_URL="https://academy.pro-everest.com"

# ─────────────────────────────────────────────────────────────
# Tarification internationale — Ariary à Madagascar, euro ailleurs
# ─────────────────────────────────────────────────────────────
# Le pays du visiteur décide de la devise affichée ET facturée. Il est déterminé par
# le middleware, dans cet ordre : GEO_FORCE_COUNTRY, puis un en-tête du reverse proxy
# (cf-ipcountry, x-vercel-ip-country…), puis une géolocalisation d'IP mise en cookie.
#
# L'infrastructure actuelle (Traefik / Dokploy) ne pose aucun en-tête de pays : c'est
# donc la géolocalisation d'IP qui sert. Si le site passe un jour derrière Cloudflare,
# `cf-ipcountry` prendra le relais tout seul, sans changement de configuration.
#
# Service de géolocalisation. `{ip}` est remplacé par l'adresse du visiteur. La réponse
# peut être un code pays brut ou un JSON portant country_code / countryCode / country.
# Interrogé UNE SEULE FOIS par visiteur (résultat mémorisé 30 jours en cookie), avec un
# délai d'attente d'une seconde : en cas de panne, le visiteur voit simplement l'ariary.
GEO_LOOKUP_URL="https://ipapi.co/{ip}/country/"
# Force le pays de TOUS les visiteurs. Sert à vérifier la vitrine en euros depuis
# Madagascar (GEO_FORCE_COUNTRY="FR") ; à laisser vide en production.
GEO_FORCE_COUNTRY=""
